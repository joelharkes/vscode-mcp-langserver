{
  "name": "mcp-langserver",
  "displayName": "MCP Language Server Bridge",
  "description": "Expose VSCode language server features as MCP tools for Claude Code",
  "version": "1.0.0",
  "publisher": "joelharkes",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/joelharkes/vscode-mcp-langserver"
  },
  "homepage": "https://github.com/joelharkes/vscode-mcp-langserver#readme",
  "bugs": {
    "url": "https://github.com/joelharkes/vscode-mcp-langserver/issues"
  },
  "galleryBanner": {
    "color": "#2b1a4e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "keywords": [
    "mcp",
    "language-server",
    "claude",
    "ai",
    "code-intelligence"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mcp-langserver.showSetupInstructions",
        "title": "MCP Langserver: Show Setup Instructions"
      }
    ],
    "configuration": {
      "title": "MCP Language Server Bridge",
      "properties": {
        "mcpLangserver.port": {
          "type": "number",
          "default": 3333,
          "description": "HTTP port for the MCP server"
        },
        "mcpLangserver.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start MCP server automatically when VSCode opens"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --production",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.2.1",
    "zod": ">=3.24.0 <4.0.0"
  }
}
